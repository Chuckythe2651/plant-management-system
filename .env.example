# ─── Database ───────────────────────────────────────────
DB_NAME=plantdb
DB_USER=plantuser
DB_PASSWORD=changeme_strong_password_here
DB_PORT=5432

# ─── Application ────────────────────────────────────────
# Port your browser will access (host port mapped to container port 80)
APP_PORT=8080

# ─── Notes ──────────────────────────────────────────────
# All API keys (OpenAI, Anthropic, Perenual, OpenWeatherMap) are
# configured in the application UI under Settings, NOT here.
# This keeps your keys in the database (persistent volume) and
# out of your shell environment / git history.
#
# Ollama: if you're running Ollama on the host machine, the
# backend will reach it at http://host.docker.internal:11434
# (already configured as default). Change in Settings if needed.
